# WebBarber - Environment shablon
# Bu faylni .env nomi bilan nusxa oling va qiymatlarni to'ldiring.

# --- Backend (server.js) uchun ---

# Telegram Bot Token (BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Adminning Telegram chat ID si (@userinfobot orqali bilib olishingiz mumkin)
ADMIN_CHAT_ID=your_admin_telegram_chat_id

# Server porti (ixtiyoriy)
PORT=3000

# true = long-polling, false = webhook
USE_POLLING=true

# --- Frontend (Supabase) uchun ---

VITE_SUPABASE_URL=your_supabase_project_url.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_STORAGE_BUCKET=barber-images
